# Route Autopsy frontend — public config only. Never put secrets in VITE_* vars (Meta credentials live ONLY in the backend .env).
# "demo" = synthetic data, no network. "backend" = real HTTP to VITE_API_BASE_URL.
VITE_APP_MODE=demo
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional request timeout in ms (default 15000; evidence upload uses 60000)
VITE_API_TIMEOUT_MS=15000
