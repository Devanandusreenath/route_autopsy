# Copy to .env (never commit .env). Only variables the backend actually reads are listed.

# --- Core ---
# SQLite file. Default: backend/routewise.db
DATABASE_PATH=
# Comma-separated browser origins allowed by CORS. localhost/127.0.0.1 on any port are always allowed (dev convenience).
# Add your deployed Lovable/preview origin here, e.g. https://my-app.lovable.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# --- Vehicle source discovery (pre-existing, optional) ---
SERPAPI_API_KEY=
SERPAPI_TIMEOUT_SECONDS=20

# --- Meta multimodal evidence engine (needed only for POST /evidence/analyze) ---
# Provider adapter. Currently supported: meta_model_api (Meta Model API, https://api.meta.ai/v1).
META_PROVIDER=meta_model_api
# API key from the Meta Model API dashboard (dev.meta.ai). Server-side only; never sent to the frontend.
META_API_KEY=
# Model id to call. REQUIRED, deliberately has no default: model ids change; pick an image-capable one from Meta's current model list.
# (muse-spark-1.1 is documented as accepting image input at the time of writing.)
META_MODEL=
# Optional override of the API base URL (default https://api.meta.ai/v1).
META_API_BASE_URL=
# Per-request timeout in seconds for the model call (minimum 5, default 45).
META_TIMEOUT_SECONDS=45
# Max accepted upload size in bytes (default 10485760 = 10 MB, matching the frontend limit).
EVIDENCE_MAX_UPLOAD_BYTES=10485760
